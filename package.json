{
  "name": "dsh-dpharness",
  "icon": "./icon.svg",
  "version": "0.6.4",
  "description": "Curated dpharness.com plugin catalog inside the DeepSeek Harness Web GUI: a conversation-view tab, a sidebar entry and a dismissible site-wide floating panel, offering a searchable full catalog, a monthly by-category shortlist, a daily pick and an update check (this plugin plus every installed plugin) with a red-dot reminder, with one-click install via dshmarket or the dsh CLI. Includes a settings page (General row + Plugins tab) for the widget visibility, the daily pick, the update check and the opt-out telemetry relay covering the full install funnel.",
  "author": "zhanghao3693 <zhanghao3693@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhanghao3693/dsh-dpharness.git"
  },
  "homepage": "https://dpharness.com/plugin/zhanghao3693/dsh-dpharness",
  "bugs": {
    "url": "https://github.com/zhanghao3693/dsh-dpharness/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
  "./locale/*.json": "./locale/*.json",
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.1.0-rc.5"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.5-rc.3": "compatible",
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.0-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "files": ["icon.svg", "locale", "lib/index.js",
    "lib/changelog.js",
    "lib/client.js",
    "lib/usage.js",
    "README.md",
    "cordis.patch.yml"],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "catalog",
    "dpharness"
  ],
  "license": "MIT"
}
